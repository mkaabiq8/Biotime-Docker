# Docker project
COMPOSE_PROJECT_NAME=biotime

# Public access. Create an A/AAAA record before publishing.
BIOTIME_DOMAIN=biotime.example.com
ACME_EMAIL=admin@example.com
DEVICE_HTTP_PORT=8080
BIOTIME_BACKEND_PORT=18090

# Windows VM. Keep UUID and MAC unchanged after BioTime activation.
WINDOWS_VERSION=10l
WINDOWS_HOSTNAME=BIOTIME
WINDOWS_USERNAME=BioTimeAdmin
WINDOWS_PASSWORD=CHANGE_ME_GENERATE_A_LONG_PASSWORD
WINDOWS_UUID=CHANGE_ME_GENERATE_A_UUID
WINDOWS_MAC=CHANGE_ME_GENERATE_A_MAC
WINDOWS_RAM_SIZE=8G
WINDOWS_CPU_CORES=4
WINDOWS_DISK_SIZE=128G
WINDOWS_LANGUAGE=English
WINDOWS_REGION=en-US
WINDOWS_KEYBOARD=en-US
TZ=Asia/Kuwait

# These ports stay on VPS loopback and are reached through an SSH tunnel.
SETUP_WEB_PORT=8006
RDP_PORT=3389

# Set to yes only after installing BioTime 8.5.5.2944 (or a vendor-confirmed
# newer fixed build). scripts/publish.sh refuses to expose BioTime otherwise.
BIOTIME_SECURITY_PATCH_CONFIRMED=no

